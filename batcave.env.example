# Batcave Cloud Example Configuration
# Copy this file outside your repository (e.g. to ~/.config/batcave-cloud/batcave.env)
# or generate it automatically using:
#   python -m server.manage create-config
#
# Batcave Cloud will automatically discover ~/.config/batcave-cloud/batcave.env.
# DO NOT COMMIT YOUR REAL SECRETS TO GIT.

# Required: A high-entropy random string for Flask session signing.
# Generated automatically by `python -m server.manage create-config`.
BATCAVE_SECRET_KEY=change_this_to_a_secure_random_string_do_not_use_in_production

# Required: A Werkzeug password hash for the single-user workspace.
# Generate via `python -m server.manage create-config` or using Werkzeug's generate_password_hash.
# Example format: scrypt:32768:8:1$...
BATCAVE_PASSWORD_HASH=pbkdf2:sha256:600000$example_hash_replace_with_real_hash

# Optional: Path to the Batcave storage root directory where user data is saved.
# Defaults to `/storage/emulated/0/BatCave` (standard Termux/Android path).
# For Linux/macOS, use an absolute path such as: ~/BatCave
# For Windows, use an absolute path such as: C:\Users\Username\BatCave
# BATCAVE_DATA_ROOT=/storage/emulated/0/BatCave

# Optional: Maximum upload size in megabytes (MB).
# Defaults to 25.
# BATCAVE_MAX_UPLOAD_MB=25

# Optional: Network interface to bind the Flask server to.
# Defaults to 0.0.0.0 (all local interfaces). Use 127.0.0.1 for localhost only.
# BATCAVE_HOST=0.0.0.0

# Optional: Port number to run the HTTP server on.
# Defaults to 8080.
# BATCAVE_PORT=8080

# Optional: Set to true if you are accessing Batcave Cloud behind an HTTPS reverse proxy.
# Defaults to false. If set to true, cookies will only be transmitted over secure HTTPS connections.
# BATCAVE_SECURE_COOKIES=false
